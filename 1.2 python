wybor = input("Wybierz skalę wejściową (C lub F): ").upper()
temp = float(input("Podaj wartość temperatury: "))

if wybor == 'C':
    wynik = temp * 1.8 + 32
    print(f"{temp}°C = {wynik}°F")
elif wybor == 'F':
    wynik = (temp - 32) / 1.8
    print(f"{temp}°F = {wynik:.2f}°C")
else:
    print("Nieprawidłowy wybór.")
