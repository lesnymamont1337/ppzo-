using System;

class Program {
    static void Main() {
        Console.Write("Wybierz skalę (C lub F): ");
        char wybor = char.ToUpper(Console.ReadKey().KeyChar);
        Console.WriteLine();
        Console.Write("Podaj temperaturę: ");
        double temp = double.Parse(Console.ReadLine());

        if (wybor == 'C') {
            double f = temp * 1.8 + 32;
            Console.WriteLine($"{temp}°C = {f}°F");
        } else if (wybor == 'F') {
            double c = (temp - 32) / 1.8;
            Console.WriteLine($"{temp}°F = {Math.Round(c, 2)}°C");
        }
    }
}
