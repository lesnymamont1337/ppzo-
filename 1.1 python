a = float(input("Podaj pierwszą liczbę: "))
b = float(input("Podaj drugą liczbę: "))
operacja = input("Wybierz operację (+, -, *, /): ")

if operacja == '+':
    wynik = a + b
elif operacja == '-':
    wynik = a - b
elif operacja == '*':
    wynik = a * b
elif operacja == '/':
    if b != 0:
        wynik = a / b
    else:
        wynik = "Błąd: Nie można dzielić przez zero!"
else:
    wynik = "Nieznana operacja"

print(f"Wynik: {wynik}")
